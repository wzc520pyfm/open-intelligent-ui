<state spend={[
  { month: "Jan", spend: 0.48, revenue: 0.92 },
  { month: "Feb", spend: 0.52, revenue: 1.05 },
  { month: "Mar", spend: 0.61, revenue: 1.18 },
  { month: "Apr", spend: 0.58, revenue: 1.24 },
  { month: "May", spend: 0.66, revenue: 1.41 },
  { month: "Jun", spend: 0.71, revenue: 1.55 },
  { month: "Jul", spend: 0.69, revenue: 1.62 },
  { month: "Aug", spend: 0.74, revenue: 1.78 },
  { month: "Sep", spend: 0.78, revenue: 1.91 },
  { month: "Oct", spend: 0.82, revenue: 2.08 },
  { month: "Nov", spend: 0.88, revenue: 2.24 }
]} />
<state regions={[
  { region: "USA", value: 2.04 },
  { region: "India", value: 1.31 },
  { region: "UK", value: 1.17 },
  { region: "Germany", value: 0.95 },
  { region: "Other", value: 1.83 }
]} />
<state years={[
  { year: "2015", sales: 4.8, spend: 3.1 },
  { year: "2017", sales: 6.2, spend: 3.4 },
  { year: "2019", sales: 8.1, spend: 3.9 },
  { year: "2021", sales: 10.4, spend: 4.6 },
  { year: "2023", sales: 13.2, spend: 5.8 },
  { year: "2025", sales: 16.2, spend: 7.3 }
]} />
<derive
  totalSpend={sumBy(spend, "spend")}
  totalSales={sumBy(spend, "revenue")}
  roi={(totalSales - totalSpend) / totalSpend}
  perDollar={totalSales / totalSpend}
/>

<style>
  .panel {
    border: 1px solid var(--iui-color-border);
    border-radius: 1.5rem;
    background: var(--iui-color-surface);
    padding: 1.15rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .panel-head { margin-bottom: 0.85rem; }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    padding: 0.45rem 0 1.05rem;
    border-bottom: 1px solid var(--iui-color-border);
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.2rem 1.15rem 0.1rem;
    border-right: 1px solid var(--iui-color-border);
    min-width: 0;
  }
  .metric:first-child { padding-left: 0; }
  .metric:last-child { border-right: none; padding-right: 0; }
  /* Value + delta on one line so a missing badge doesn't leave a hole. */
  .metric-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.55rem;
    min-width: 0;
  }
  .section {
    padding: 1rem 0;
    border-bottom: 1px solid var(--iui-color-border);
  }
  .section:last-child { border-bottom: none; padding-bottom: 0; }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 1.25rem;
  }
  /* Surface width, not viewport — playground phone mode only shrinks the column. */
  @container iui (width < 520px) {
    .panel { padding: 1rem 1.05rem 1.1rem; }
    .metrics { grid-template-columns: 1fr; }
    .metric { border-right: none; border-bottom: 1px solid var(--iui-color-border); padding: 0.7rem 0; }
    .metric:last-child { border-bottom: none; }
    .split { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>

<div class="panel" motion="pop">
  <div class="panel-head" motion="blur">
    <title level={2}>Ad Spend vs Sales</title>
    <text size="sm" color="muted">Across all regions in 2025 (YTD), every $1 of ad spend returned ${num(perDollar, 2)} in sales.</text>
  </div>

  <div class="metrics" stagger={50}>
    <div class="metric" motion="blur">
      <div class="metric-head">
        <text size="xl" weight="bold" tabular>{"$" + num(totalSpend, 2) + "Mn"}</text>
        <badge color="success" size="sm">+4.8%</badge>
      </div>
      <text size="sm" color="muted">Total spend</text>
    </div>
    <div class="metric" motion="blur">
      <div class="metric-head">
        <text size="xl" weight="bold" tabular>{"$" + num(totalSales, 2) + "Mn"}</text>
        <badge color="success" size="sm">+10.7%</badge>
      </div>
      <text size="sm" color="muted">Total sales</text>
    </div>
    <div class="metric" motion="blur">
      <div class="metric-head">
        <text size="xl" weight="bold" tabular><Number value={roi} format="percent" digits={1} /></text>
      </div>
      <text size="sm" color="muted">Return on investment</text>
    </div>
  </div>

  <div class="section" motion="blur">
    <row gap={2} style="margin-bottom: 0.55rem">
      <title level={3}>Spend vs revenue, 2025</title>
      <spacer />
    </row>
    <Chart type="bar" data={spend} x="month" y={["spend", "revenue"]} names={{ spend: "Spend", revenue: "Revenue" }} format="currency" currency="USD" unit="M" height={210} legend aria-label="Monthly spend and revenue in millions of dollars" />
  </div>

  <div class="section">
    <div class="split">
      <box gap={2} motion="blur">
        <title level={3}>Share of global spend</title>
        <Chart type="donut" data={regions} x="region" y="value" format="currency" currency="USD" unit="M" height={170} legend aria-label="Spend by region in millions of dollars" />
      </box>
      <box gap={2} motion="blur">
        <row gap={2}>
          <title level={3}>Sales and spend over time</title>
          <spacer />
          <badge color="accent" size="sm" motion="pop">3× since 2015</badge>
        </row>
        <Chart type="area" data={years} x="year" y={["sales", "spend"]} names={{ sales: "Sales", spend: "Spend" }} format="currency" currency="USD" unit="M" height={170} legend aria-label="Sales and spend from 2015 to 2025 in millions of dollars" />
      </box>
    </div>
  </div>
</div>
