{
  "name": "open-intelligent-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Open Intelligent UI: let agents author real interfaces from behaviors (UI SDK), a design system (DESIGN.md) and motion rules.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @open-intelligent-ui/playground dev",
    "build": "pnpm --filter @open-intelligent-ui/playground build",
    "preview": "pnpm --filter @open-intelligent-ui/playground preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "generate": "node scripts/generate-ui-sdk.mjs",
    "design:lint": "node scripts/lint-design.mjs"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
