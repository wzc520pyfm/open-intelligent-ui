{
  "name": "@open-intelligent-ui/react",
  "version": "0.1.0",
  "description": "React renderer for Open Intelligent UI. Renders streaming IUI markup with UI SDK behaviors, DESIGN.md tokens and motion.",
  "keywords": [
    "generative-ui",
    "intelligent-ui",
    "agent",
    "llm",
    "react",
    "ui-sdk",
    "design-md",
    "streaming"
  ],
  "homepage": "https://github.com/wzc520pyfm/open-intelligent-ui#readme",
  "bugs": "https://github.com/wzc520pyfm/open-intelligent-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/open-intelligent-ui.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui-sdk": "./src/registry/ui-sdk.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ui-sdk": {
        "types": "./dist/ui-sdk.d.ts",
        "default": "./dist/ui-sdk.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@open-intelligent-ui/core": "workspace:*",
    "lucide-react": "^1.77.0"
  },
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/react": "^0.1.0-beta.13",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
