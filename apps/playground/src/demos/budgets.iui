<state cash={[
  { month: "Aug", inn: 182, out: 146 },
  { month: "Sep", inn: 198, out: 161 },
  { month: "Oct", inn: 214, out: 168 },
  { month: "Nov", inn: 231, out: 175 }
]} />
<state depts={[
  { name: "Engineering", spent: 312, budget: 360 },
  { name: "Sales", spent: 188, budget: 210 },
  { name: "Marketing", spent: 142, budget: 160 },
  { name: "Ops", spent: 96, budget: 120 }
]} />

<box gap={4}>
  <row wrap gap={2}>
    <title level={2}>Q4 budget</title>
    <spacer />
    <badge variant="soft" size="sm"><icon name="refresh-cw" size="sm" /> Just refreshed</badge>
    <Button size="sm">This quarter</Button>
    <Button size="sm" variant="solid">Export</Button>
  </row>

  <grid columns={4} gap={2} stagger>
    <card padding={3} gap={1}>
      <row gap={2}><icon name="trending-up" size="sm" color="accent" /><text size="sm" color="muted">Revenue</text></row>
      <text size="xl" weight="bold" tabular>$1.25M</text>
      <badge color="success" size="sm">+8.1%</badge>
    </card>
    <card padding={3} gap={1}>
      <row gap={2}><icon name="wallet" size="sm" color="accent" /><text size="sm" color="muted">Operating spend</text></row>
      <text size="xl" weight="bold" tabular>$815k</text>
      <badge color="success" size="sm">4.0% under</badge>
    </card>
    <card padding={3} gap={1}>
      <row gap={2}><icon name="pie-chart" size="sm" color="accent" /><text size="sm" color="muted">Gross margin</text></row>
      <text size="xl" weight="bold" tabular>62.6%</text>
      <badge color="success" size="sm">+1.2 pt</badge>
    </card>
    <card padding={3} gap={1}>
      <row gap={2}><icon name="timer" size="sm" color="accent" /><text size="sm" color="muted">Runway</text></row>
      <text size="xl" weight="bold" tabular>22 mo</text>
      <badge color="success" size="sm">+2 mo</badge>
    </card>
  </grid>

  <grid columns={3} gap={3}>
    <grid-item span={2}>
      <card padding={4} gap={3}>
        <title level={3}>Cash flow</title>
        <Chart
          type="bar"
          data={cash}
          x="month"
          y={["inn", "out"]}
          names={{ inn: "Cash in", out: "Cash out" }}
          format="compact"
          currency="USD"
          unit="k"
          height={180}
          legend
          aria-label="Monthly cash in and cash out in thousands of dollars"
        />
      </card>
    </grid-item>
    <card padding={4} gap={3}>
      <title level={3}>Budget vs actual</title>
      <box gap={3}>
        {#each depts as dept (dept.name)}
          <box gap={1}>
            <row gap={2}>
              <text size="sm" weight="medium">{dept.name}</text>
              <spacer />
              <text size="xs" tabular color="muted">${dept.spent}k / ${dept.budget}k</text>
            </row>
            <Progress value={dept.spent} max={dept.budget} aria-label="{dept.name} spend versus budget">
              <ProgressTrack><ProgressIndicator /></ProgressTrack>
            </Progress>
          </box>
        {/each}
      </box>
    </card>
  </grid>

  <card padding={4} gap={3}>
    <title level={3}>Recent invoices</title>
    <DataTable data={[
      { vendor: "Vercel", category: "Infra", id: "INV-2041", due: "Nov 12", amount: 4200, status: "paid" },
      { vendor: "Snowflake", category: "Data", id: "INV-2048", due: "Nov 18", amount: 12800, status: "scheduled" },
      { vendor: "Figma", category: "Design", id: "INV-2052", due: "Nov 22", amount: 960, status: "paid" },
      { vendor: "Datadog", category: "Observability", id: "INV-2055", due: "Nov 28", amount: 6100, status: "overdue" }
    ]} rowKey="id" columns={[
      { key: "vendor", label: "Vendor" },
      { key: "category", label: "Category" },
      { key: "id", label: "Invoice" },
      { key: "due", label: "Due" },
      { key: "amount", label: "Amount", format: "currency", align: "right" },
      { key: "status", label: "Status", badge: { paid: "success", scheduled: "info", overdue: "danger" } }
    ]} />
  </card>
</box>
