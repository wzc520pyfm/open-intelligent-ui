{
  "name": "@open-intelligent-ui/svelte",
  "version": "0.2.0",
  "description": "Svelte renderer for Open Intelligent UI: turns IUI markup written by a model into a live, stateful, animated interface built on UI SDK.",
  "keywords": [
    "generative-ui",
    "intelligent-ui",
    "agent",
    "llm",
    "svelte",
    "ui-sdk",
    "design-md"
  ],
  "homepage": "https://github.com/wzc520pyfm/open-intelligent-ui#readme",
  "bugs": "https://github.com/wzc520pyfm/open-intelligent-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/open-intelligent-ui.git",
    "directory": "packages/svelte"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui-sdk": "./src/registry/ui-sdk.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./ui-sdk": {
        "types": "./dist/registry/ui-sdk.d.ts",
        "default": "./dist/registry/ui-sdk.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && node ../../scripts/build-css.mjs",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "lucide": "1.77.0",
    "@open-intelligent-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/svelte": "^0.1.0-beta.13",
    "svelte": ">=5.33"
  },
  "devDependencies": {
    "@open-intelligent-ui/react": "workspace:*",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "@ui-sdk/svelte": "0.1.0-beta.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3"
  }
}
