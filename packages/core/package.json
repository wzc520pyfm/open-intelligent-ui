{
  "name": "@open-intelligent-ui/core",
  "version": "0.3.0",
  "description": "Framework-free core of Open Intelligent UI: the IUI markup parser, safe expression language, surface store, DESIGN.md loader, system prompt builder, and what the renderers share.",
  "keywords": [
    "generative-ui",
    "intelligent-ui",
    "agent",
    "llm",
    "markup",
    "design-md",
    "ui-sdk"
  ],
  "homepage": "https://github.com/wzc520pyfm/open-intelligent-ui#readme",
  "bugs": "https://github.com/wzc520pyfm/open-intelligent-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/open-intelligent-ui.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/prompt/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./charts": "./src/charts/index.ts",
    "./motion": "./src/motion/index.ts",
    "./styles.css": "./styles/index.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./prompt": {
        "types": "./dist/prompt.d.ts",
        "default": "./dist/prompt.js"
      },
      "./renderer": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "./charts": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.js"
      },
      "./motion": {
        "types": "./dist/motion.d.ts",
        "default": "./dist/motion.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/build-css.mjs",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "marked": "^18.2.1",
    "yaml": "^2.9.1"
  }
}
