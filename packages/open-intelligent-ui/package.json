{
  "name": "open-intelligent-ui",
  "version": "0.1.0",
  "description": "Open Intelligent UI: interfaces a model writes as markup. This package re-exports @open-intelligent-ui/core; the renderers are @open-intelligent-ui/react and friends.",
  "keywords": [
    "generative-ui",
    "intelligent-ui",
    "agent",
    "llm",
    "markup",
    "design-md",
    "ui-sdk"
  ],
  "homepage": "https://github.com/wzc520pyfm/open-intelligent-ui#readme",
  "bugs": "https://github.com/wzc520pyfm/open-intelligent-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/open-intelligent-ui.git",
    "directory": "packages/open-intelligent-ui"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/prompt.ts"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./prompt": {
        "types": "./dist/prompt.d.ts",
        "default": "./dist/prompt.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@open-intelligent-ui/core": "workspace:*"
  }
}
