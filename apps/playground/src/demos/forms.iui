<state interests={["food", "culture"]} stay="boutique" budget={1750} adults={2} children={0} />
<derive interestOptions={[
  { id: "food", label: "Food", icon: "utensils" },
  { id: "culture", label: "Culture", icon: "landmark" },
  { id: "beaches", label: "Beaches", icon: "waves" },
  { id: "nightlife", label: "Nightlife", icon: "music" },
  { id: "outdoors", label: "Outdoors", icon: "tree-pine" },
  { id: "shopping", label: "Shopping", icon: "shopping-bag" }
]} />

<style>
  .nowrap { white-space: nowrap; overflow-wrap: normal; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip-row button,
  .stay-pick {
    appearance: none;
    border: 1px solid var(--iui-color-border);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    background: var(--iui-color-muted);
    color: var(--iui-color-foreground);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      border-color var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      background var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      scale var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing);
  }
  .chip-row button[aria-pressed="true"] {
    border-color: var(--iui-color-primary);
    background: color-mix(in oklab, var(--iui-color-primary) 12%, var(--iui-color-surface));
  }
  .stay-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .stay-pick {
    border-radius: var(--iui-radius-lg);
    padding: 0.9rem 0.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    text-align: center;
  }
  .stay-pick[aria-pressed="true"] {
    border-color: var(--iui-color-primary);
    background: color-mix(in oklab, var(--iui-color-primary) 10%, var(--iui-color-surface));
  }
</style>

<title level={2}>Plan a week in Portugal</title>

<card padding={4} gap={4}>
  <box gap={2}>
    <text size="sm" weight="medium">Destinations</text>
    <row gap={2} wrap>
      <badge color="accent"><icon name="map-pin" size="sm" /> Lisbon</badge>
      <badge color="info"><icon name="map-pin" size="sm" /> Porto</badge>
    </row>
  </box>
  <grid columns={2} gap={3}>
    <box gap={1}>
      <text size="sm" weight="medium">Check-in / Check-out</text>
      <row gap={2}>
        <badge variant="soft"><icon name="calendar" size="sm" /> Apr 12</badge>
        <badge variant="soft"><icon name="calendar" size="sm" /> Apr 19</badge>
      </row>
    </box>
    <box gap={1}>
      <text size="sm" weight="medium">Travelers</text>
      <row gap={3}>
        <row gap={2} class="nowrap">
          <text size="sm" color="muted">Adults</text>
          <NumberInput min={1} max={8} bind:value={adults}>
            <NumberInputGroup>
              <NumberInputDecrement aria-label="Fewer adults">−</NumberInputDecrement>
              <NumberInputControl aria-label="Adults" style="width: 2.5rem; text-align: center" />
              <NumberInputIncrement aria-label="More adults">+</NumberInputIncrement>
            </NumberInputGroup>
          </NumberInput>
        </row>
        <row gap={2} class="nowrap">
          <text size="sm" color="muted">Children</text>
          <NumberInput min={0} max={6} bind:value={children}>
            <NumberInputGroup>
              <NumberInputDecrement aria-label="Fewer children">−</NumberInputDecrement>
              <NumberInputControl aria-label="Children" style="width: 2.5rem; text-align: center" />
              <NumberInputIncrement aria-label="More children">+</NumberInputIncrement>
            </NumberInputGroup>
          </NumberInput>
        </row>
      </row>
    </box>
  </grid>
  <box gap={2}>
    <text size="sm" weight="medium">Interests</text>
    <div class="chip-row">
      {#each interestOptions as opt (opt.id)}
        <button type="button" aria-pressed={interests.includes(opt.id)} on:click={interests = toggle(interests, opt.id)}>
          <icon name={opt.icon} size="sm" /> {opt.label}
        </button>
      {/each}
    </div>
  </box>
  <box gap={2}>
    <text size="sm" weight="medium">Stay</text>
    <div class="stay-grid">
      <button type="button" class="stay-pick" aria-pressed={stay == "boutique"} on:click={stay = "boutique"}>
        <icon name="building-2" size="lg" />
        <text size="sm" weight="medium">Boutique hotel</text>
      </button>
      <button type="button" class="stay-pick" aria-pressed={stay == "apartment"} on:click={stay = "apartment"}>
        <icon name="home" size="lg" />
        <text size="sm" weight="medium">Apartment</text>
      </button>
      <button type="button" class="stay-pick" aria-pressed={stay == "resort"} on:click={stay = "resort"}>
        <icon name="palmtree" size="lg" />
        <text size="sm" weight="medium">Resort</text>
      </button>
    </div>
  </box>
  <box gap={1}>
    <row>
      <text size="sm" weight="medium">Budget</text>
      <spacer />
      <text size="sm" tabular>{currency(500)}–{currency(budget)}</text>
    </row>
    <Slider min={500} max={5000} step={50} bind:value={budget}>
      <SliderControl><SliderTrack><SliderIndicator /><SliderThumb aria-label="Trip budget" /></SliderTrack></SliderControl>
    </Slider>
    <row>
      <text size="xs" color="muted">$500</text>
      <spacer />
      <text size="xs" color="muted">$5,000</text>
    </row>
  </box>
  <row gap={2} wrap>
    <Button variant="solid" on:click={send("Plan my trip", { interests, stay, budget, adults, children })}>Plan my trip</Button>
    <Button on:click={send("Save this trip for later")}>Save for later</Button>
  </row>
</card>
