{
  "name": "@open-intelligent-ui/react",
  "version": "0.1.0",
  "description": "React renderer for Open Intelligent UI. Renders streaming IUI markup with UI SDK behaviors, DESIGN.md tokens and motion.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui-sdk": "./src/registry/ui-sdk.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@open-intelligent-ui/core": "workspace:*",
    "lucide-react": "^1.77.0"
  },
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/react": "^0.1.0-beta.13",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
