<state interests={["food", "culture"]} stay={["boutique", "apartment"]} budgetMin={1000} budget={2500} adults={2} children={0} />
<derive interestOptions={[
  { id: "food", label: "Food", icon: "utensils" },
  { id: "culture", label: "Culture", icon: "landmark" },
  { id: "beaches", label: "Beaches", icon: "waves" },
  { id: "nightlife", label: "Nightlife", icon: "music" },
  { id: "outdoors", label: "Hiking", icon: "tree-pine" },
  { id: "shopping", label: "Relaxing", icon: "coffee" }
]} />

<style>
  .panel {
    border: 1px solid var(--iui-color-border);
    border-radius: 1.5rem;
    background: var(--iui-color-surface);
    padding: 1.2rem 1.3rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }
  .rule {
    border: none;
    border-top: 1px dashed var(--iui-color-border);
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.65rem;
    border-radius: var(--iui-radius-md);
    border: 1px solid var(--iui-color-border);
    background: var(--iui-color-muted);
  }
  .field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.45rem 0.7rem;
    border-radius: var(--iui-radius-md);
    border: 1px solid var(--iui-color-border);
    background: var(--iui-color-muted);
  }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  /* Selection follows the design accent (Noir: luminous blue), not a white outline. */
  .chip-row button,
  .stay-pick {
    appearance: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    background: color-mix(in oklab, var(--iui-color-foreground) 6%, transparent);
    color: var(--iui-color-foreground);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    box-shadow: none;
    transition:
      background var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      box-shadow var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      color var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      scale var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing);
  }
  .chip-row button[aria-pressed="true"],
  .stay-pick[aria-pressed="true"] {
    background: color-mix(in oklab, var(--iui-color-accent) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--iui-color-accent) 80%, transparent);
    color: color-mix(in oklab, var(--iui-color-accent) 35%, var(--iui-color-foreground));
  }
  .stay-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .stay-pick {
    border-radius: var(--iui-radius-lg);
    padding: 0.85rem 0.45rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    white-space: nowrap;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .split { grid-template-columns: 1fr; }
    .stay-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="panel" motion="pop">
  <box gap={1} motion="blur">
    <title level={2}>Plan your next vacation</title>
    <text size="sm" color="muted">Tell me a little about the trip and I'll build the itinerary.</text>
  </box>

  <box gap={2} motion="blur">
    <text size="sm" weight="medium">Destinations</text>
    <div class="tags">
      <badge color="info"><icon name="bus" size="sm" /> Lisbon ×</badge>
      <badge color="accent"><icon name="map-pin" size="sm" /> Porto ×</badge>
      <text size="sm" color="muted">Add a city…</text>
      <spacer />
      <icon name="chevrons-up-down" size="sm" color="muted" />
    </div>
  </box>

  <hr class="rule" />

  <grid columns={2} gap={3} motion="blur">
    <box gap={2}>
      <text size="sm" weight="medium">Check-in</text>
      <div class="field"><icon name="calendar" size="sm" color="muted" /><text size="sm">Tue, May 12</text></div>
    </box>
    <box gap={2}>
      <text size="sm" weight="medium">Check-out</text>
      <div class="field"><icon name="calendar" size="sm" color="muted" /><text size="sm">Mon, May 18</text></div>
    </box>
  </grid>

  <grid columns={2} gap={3} motion="blur">
    <box gap={2}>
      <text size="sm" weight="medium">Adults</text>
      <NumberInput min={1} max={8} bind:value={adults}>
        <NumberInputGroup>
          <NumberInputDecrement aria-label="Fewer adults">−</NumberInputDecrement>
          <NumberInputControl aria-label="Adults" style="width: 2.5rem; text-align: center" />
          <NumberInputIncrement aria-label="More adults">+</NumberInputIncrement>
        </NumberInputGroup>
      </NumberInput>
    </box>
    <box gap={2}>
      <text size="sm" weight="medium">Children</text>
      <NumberInput min={0} max={6} bind:value={children}>
        <NumberInputGroup>
          <NumberInputDecrement aria-label="Fewer children">−</NumberInputDecrement>
          <NumberInputControl aria-label="Children" style="width: 2.5rem; text-align: center" />
          <NumberInputIncrement aria-label="More children">+</NumberInputIncrement>
        </NumberInputGroup>
      </NumberInput>
    </box>
  </grid>

  <hr class="rule" />

  <div class="split" motion="blur">
    <box gap={2}>
      <text size="sm" weight="medium">Interests</text>
      <div class="chip-row">
        {#each interestOptions as opt (opt.id)}
          <button type="button" aria-pressed={interests.includes(opt.id)} on:click={interests = toggle(interests, opt.id)}>
            {#if interests.includes(opt.id)}<icon name="check" size="sm" />{:else}<icon name={opt.icon} size="sm" />{/if}
            {opt.label}
          </button>
        {/each}
      </div>
    </box>
    <box gap={2}>
      <text size="sm" weight="medium">Stay</text>
      <div class="stay-grid">
        <button type="button" class="stay-pick" aria-pressed={stay.includes("boutique")} on:click={stay = toggle(stay, "boutique")}>
          <icon name="building-2" size="lg" />
          <text size="sm" weight="medium">Boutique hotel</text>
        </button>
        <button type="button" class="stay-pick" aria-pressed={stay.includes("apartment")} on:click={stay = toggle(stay, "apartment")}>
          <icon name="home" size="lg" />
          <text size="sm" weight="medium">Apartment</text>
        </button>
        <button type="button" class="stay-pick" aria-pressed={stay.includes("resort")} on:click={stay = toggle(stay, "resort")}>
          <icon name="palmtree" size="lg" />
          <text size="sm" weight="medium">Resort</text>
        </button>
      </div>
    </box>
  </div>

  <hr class="rule" />

  <box gap={2} motion="blur">
    <row>
      <text size="sm" weight="medium">Budget per person</text>
      <spacer />
      <text size="sm" tabular>{currency(budgetMin)} – {currency(budget)}</text>
    </row>
    <Slider min={0} max={5000} step={50} bind:value={budget}>
      <SliderControl><SliderTrack><SliderIndicator /><SliderThumb aria-label="Trip budget" /></SliderTrack></SliderControl>
    </Slider>
    <row>
      <text size="xs" color="muted">$0</text>
      <spacer />
      <text size="xs" color="muted">$5,000+</text>
    </row>
  </box>

  <row gap={2} wrap motion="blur">
    <Button variant="solid" on:click={send("Plan my trip", { interests, stay, budget, adults, children })}>Plan my trip</Button>
    <Button on:click={send("Save this trip for later")}>Save for later</Button>
  </row>
</div>
