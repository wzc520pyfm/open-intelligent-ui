<state monthly={500} rate={6} years={20} start={5000} />
<derive
  months={years * 12}
  r={rate / 100 / 12}
  series={range(0, years + 1).map(y => ({
    year: "Y" + y,
    invested: start + monthly * 12 * y,
    value: round(start * (1 + r) ** (y * 12) + (r == 0 ? monthly * 12 * y : monthly * (((1 + r) ** (y * 12) - 1) / r)))
  }))}
  final={last(series).value}
  invested={last(series).invested}
  growth={final - invested}
/>

<row align="end" gap={3} wrap>
  <box gap={0}>
    <text size="sm" color="muted">After {years} years you would have</text>
    <text size="4xl" weight="bold" tabular><Number value={final} format="currency" digits={0} /></text>
  </box>
  <spacer />
  <badge color="success" size="lg">{percent(growth / final)} of it is growth</badge>
</row>

<grid columns={3} gap={4}>
  <grid-item span={2}>
    <card padding={4}>
      <Chart type="area" data={series} x="year" y={["value", "invested"]} names={{ value: "Balance", invested: "Paid in" }} format="compact" currency="USD" height={240} legend aria-label="Balance and amount paid in, by year" />
    </card>
  </grid-item>
  <card padding={4} gap={4}>
    <Slider min={0} max={3000} step={50} bind:value={monthly}>
      <row><text size="sm" color="muted">Monthly</text><spacer /><text size="sm" tabular weight="medium">{currency(monthly)}</text></row>
      <SliderControl><SliderTrack><SliderIndicator /><SliderThumb aria-label="Monthly contribution" /></SliderTrack></SliderControl>
    </Slider>
    <Slider min={0} max={12} step={0.5} bind:value={rate}>
      <row><text size="sm" color="muted">Yearly return</text><spacer /><text size="sm" tabular weight="medium">{rate}%</text></row>
      <SliderControl><SliderTrack><SliderIndicator /><SliderThumb aria-label="Yearly return" /></SliderTrack></SliderControl>
    </Slider>
    <Slider min={1} max={40} bind:value={years}>
      <row><text size="sm" color="muted">Years</text><spacer /><text size="sm" tabular weight="medium">{years}</text></row>
      <SliderControl><SliderTrack><SliderIndicator /><SliderThumb aria-label="Years" /></SliderTrack></SliderControl>
    </Slider>
    <divider />
    <row><text size="sm" color="muted">You pay in</text><spacer /><text size="sm" tabular>{currency(invested)}</text></row>
    <row><text size="sm" color="muted">Growth</text><spacer /><text size="sm" tabular color="success">{signed(round(growth))}</text></row>
  </card>
</grid>

{#if rate >= 9}
  <card variant="soft" padding={3} motion="fade">
    <row gap={2} align="start"><icon name="triangle-alert" color="warning" /><text size="sm">{rate}% a year is above the long-run stock market average of roughly 6–7% after inflation. Plan on less.</text></row>
  </card>
{/if}

<row gap={2} wrap>
  <Button variant="solid" on:click={send("Turn this into a savings plan I can follow", { monthly, rate, years })}>Make this my plan</Button>
  <Button on:click={reset()}>Reset</Button>
</row>
