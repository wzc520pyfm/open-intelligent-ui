<state workshops={[
  { id: "clay", name: "Wheel throwing", host: "Atelier Midori", when: "Sat 10:00", seats: 4, tag: "Hands-on", color: "accent", blurb: "Throw three cups; glaze fired mid-week.", price: 68 },
  { id: "print", name: "Risograph posters", host: "Ink & Grain", when: "Sat 14:00", seats: 6, tag: "Studio", color: "info", blurb: "Two-color print run you take home.", price: 54 },
  { id: "ferment", name: "Koji basics", host: "Nara Pantry", when: "Sun 11:00", seats: 8, tag: "Food", color: "success", blurb: "Start a koji tray and plan the week of care.", price: 42 }
]} />
<derive picked={workshops.find(w => w.id == "clay")} />

<style>
  .panel {
    border: 1px solid var(--iui-color-border);
    border-radius: 1.5rem;
    background: var(--iui-color-surface);
    padding: 1.15rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pick {
    display: grid;
    grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.4fr);
    gap: 0.9rem;
    padding: 0.85rem;
    border-radius: var(--iui-radius-lg);
    border: 1px solid var(--iui-color-border);
    background: color-mix(in oklab, var(--iui-color-accent) 8%, var(--iui-color-surface));
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--iui-color-accent) 20%, transparent);
  }
  .pick-art {
    border-radius: var(--iui-radius-md);
    overflow: hidden;
    min-height: 7.5rem;
    background: var(--iui-color-muted);
  }
  .pick-art svg { width: 100%; height: 100%; display: block; }
  .list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .row-card {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.7rem 0.75rem;
    border-radius: var(--iui-radius-md);
    border: 1px solid var(--iui-color-border);
    background: color-mix(in oklab, var(--iui-color-muted) 55%, transparent);
    min-width: 0;
  }
  .thumb {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 10px;
    overflow: hidden;
    background: var(--iui-color-muted);
    flex: 0 0 auto;
  }
  .thumb svg { width: 100%; height: 100%; display: block; }
  .meta { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .price { text-align: right; white-space: nowrap; }
  @container iui (width < 520px) {
    .panel { padding: 0.95rem 0.95rem 1.05rem; }
    .pick { grid-template-columns: 1fr; }
    .pick-art { min-height: 8rem; }
    .row-card { grid-template-columns: 3.5rem minmax(0, 1fr); }
    .row-card .price { grid-column: 2; text-align: left; }
    .thumb { width: 3.5rem; height: 3.5rem; }
  }
</style>

<div class="panel" motion="pop">
  <box gap={1} motion="blur">
    <title level={2}>Weekend workshops near Gion</title>
    <text size="sm" color="muted">Three open seats this Saturday–Sunday. Start with the strongest match, then browse the rest.</text>
  </box>

  <div class="pick" motion="blur">
    <div class="pick-art" aria-hidden="true">
      <svg viewBox="0 0 160 120" preserveAspectRatio="xMidYMid slice">
        <rect width="160" height="120" fill="var(--iui-color-chart-1)" opacity="0.3" />
        <ellipse cx="80" cy="78" rx="46" ry="14" fill="var(--iui-color-chart-1)" opacity="0.45" />
        <rect x="58" y="28" width="44" height="52" rx="22" fill="var(--iui-color-surface)" opacity="0.5" />
        <circle cx="80" cy="44" r="10" fill="var(--iui-color-chart-2)" opacity="0.7" />
      </svg>
    </div>
    <box gap={2}>
      <row gap={2} wrap>
        <badge color="warning" size="sm"><icon name="sparkles" size="sm" /> Best match</badge>
        <badge color={picked.color} size="sm">{picked.tag}</badge>
      </row>
      <title level={3}>{picked.name}</title>
      <text size="sm" color="muted">{picked.host} · {picked.when} · {picked.seats} seats left</text>
      <text size="sm">{picked.blurb}</text>
      <row gap={2} style="margin-top: auto">
        <text weight="semibold" tabular>${picked.price}</text>
        <spacer />
        <Button variant="solid" on:click={send("Book " + picked.name + " with " + picked.host)}>Reserve</Button>
      </row>
    </box>
  </div>

  <div class="list" stagger={55}>
    {#each workshops.filter(w => w.id != picked.id) as shop (shop.id)}
      <div class="row-card" motion="blur">
        <div class="thumb" aria-hidden="true">
          <svg viewBox="0 0 72 72">
            {#if shop.id == "clay"}
              <rect width="72" height="72" fill="var(--iui-color-chart-1)" opacity="0.35" />
              <ellipse cx="36" cy="48" rx="18" ry="7" fill="var(--iui-color-chart-1)" opacity="0.55" />
              <rect x="26" y="18" width="20" height="28" rx="10" fill="var(--iui-color-surface)" opacity="0.45" />
            {:else if shop.id == "print"}
              <rect width="72" height="72" fill="var(--iui-color-chart-3)" opacity="0.35" />
              <rect x="14" y="18" width="44" height="36" rx="4" fill="var(--iui-color-chart-2)" opacity="0.5" />
              <rect x="20" y="24" width="20" height="8" rx="2" fill="var(--iui-color-surface)" opacity="0.55" />
            {:else}
              <rect width="72" height="72" fill="var(--iui-color-chart-2)" opacity="0.35" />
              <circle cx="36" cy="34" r="16" fill="var(--iui-color-chart-1)" opacity="0.45" />
              <rect x="22" y="48" width="28" height="10" rx="3" fill="var(--iui-color-surface)" opacity="0.5" />
            {/if}
          </svg>
        </div>
        <div class="meta">
          <row gap={2} wrap>
            <text size="sm" weight="semibold">{shop.name}</text>
            <badge color={shop.color} size="sm">{shop.tag}</badge>
          </row>
          <text size="xs" color="muted">{shop.host} · {shop.when}</text>
          <text size="xs" color="muted">{shop.seats} seats · {shop.blurb}</text>
        </div>
        <div class="price">
          <text size="sm" weight="semibold" tabular>${shop.price}</text>
          <box gap={1} style="margin-top: 0.35rem">
            <Button size="sm" on:click={send("Tell me more about " + shop.name)}>Details</Button>
          </box>
        </div>
      </div>
    {/each}
  </div>
</div>
