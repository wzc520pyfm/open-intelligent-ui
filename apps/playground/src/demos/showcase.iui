<state view="charts" />
<state spend={[
  { month: "Jan", spend: 0.48, revenue: 0.92 },
  { month: "Feb", spend: 0.52, revenue: 1.05 },
  { month: "Mar", spend: 0.61, revenue: 1.18 },
  { month: "Apr", spend: 0.58, revenue: 1.24 },
  { month: "May", spend: 0.66, revenue: 1.41 },
  { month: "Jun", spend: 0.71, revenue: 1.55 },
  { month: "Jul", spend: 0.69, revenue: 1.62 },
  { month: "Aug", spend: 0.74, revenue: 1.78 },
  { month: "Sep", spend: 0.78, revenue: 1.91 },
  { month: "Oct", spend: 0.82, revenue: 2.08 },
  { month: "Nov", spend: 0.88, revenue: 2.24 }
]} />
<state regions={[
  { region: "USA", value: 2.04 },
  { region: "India", value: 1.31 },
  { region: "UK", value: 1.17 },
  { region: "Germany", value: 0.95 },
  { region: "Other", value: 1.83 }
]} />
<state years={[
  { year: "2015", sales: 4.8, spend: 3.1 },
  { year: "2017", sales: 6.2, spend: 3.4 },
  { year: "2019", sales: 8.1, spend: 3.9 },
  { year: "2021", sales: 10.4, spend: 4.6 },
  { year: "2023", sales: 13.2, spend: 5.8 },
  { year: "2025", sales: 16.2, spend: 7.3 }
]} />
<state hotels={[
  { id: "marais", name: "Hôtel du Marais", rating: 4.8, price: "€€€", tag: "Free Wifi", color: "success", blurb: "Quiet courtyard near the Seine." },
  { id: "latin", name: "Maison Latin", rating: 4.6, price: "€€", tag: "Family-friendly", color: "accent", blurb: "Steps from the Luxembourg Gardens." },
  { id: "opera", name: "Opera House Inn", rating: 4.9, price: "€€€€", tag: "Top pick", color: "warning", blurb: "Rooftop breakfast and a piano bar." }
]} />
<state interests={["food", "culture"]} stay="boutique" budget={1750} adults={2} children={0} />
<state cash={[
  { month: "Aug", inn: 182, out: 146 },
  { month: "Sep", inn: 198, out: 161 },
  { month: "Oct", inn: 214, out: 168 },
  { month: "Nov", inn: 231, out: 175 }
]} />
<state depts={[
  { name: "Engineering", spent: 312, budget: 360 },
  { name: "Sales", spent: 188, budget: 210 },
  { name: "Marketing", spent: 142, budget: 160 },
  { name: "Ops", spent: 96, budget: 120 }
]} />
<derive
  totalSpend={sumBy(spend, "spend")}
  totalSales={sumBy(spend, "revenue")}
  roi={(totalSales - totalSpend) / totalSpend}
  picked={hotels.find(h => h.id == "opera")}
  interestOptions={[
    { id: "food", label: "Food", icon: "utensils" },
    { id: "culture", label: "Culture", icon: "landmark" },
    { id: "beaches", label: "Beaches", icon: "waves" },
    { id: "nightlife", label: "Nightlife", icon: "music" },
    { id: "outdoors", label: "Outdoors", icon: "tree-pine" },
    { id: "shopping", label: "Shopping", icon: "shopping-bag" }
  ]}
/>

<style>
  .showcase {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 28rem;
    padding-bottom: 0.25rem;
  }
  .showcase-panel {
    min-height: 22rem;
    padding-bottom: 3.25rem;
  }
  .showcase-split {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.2fr);
  }
  @container iui (max-width: 720px) {
    .showcase-split { grid-template-columns: 1fr; }
  }
  .showcase-copy { display: flex; flex-direction: column; gap: 0.85rem; }
  .showcase-copy ul { padding-left: 1.1rem; color: var(--iui-color-muted-foreground); }
  .showcase-copy li + li { margin-top: 0.35rem; }
  .dock {
    position: sticky;
    bottom: 0.35rem;
    z-index: 2;
    align-self: center;
    display: flex;
    gap: 0.25rem;
    margin-top: auto;
    padding: 0.3rem;
    border: 1px solid color-mix(in oklab, var(--iui-color-border) 80%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--iui-color-surface) 92%, transparent);
    box-shadow: var(--iui-shadow-lg);
    backdrop-filter: blur(12px);
  }
  .nowrap { white-space: nowrap; overflow-wrap: normal; }
  .dock button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    background: transparent;
    color: var(--iui-color-muted-foreground);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      color var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      scale var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing);
  }
  .dock button[aria-selected="true"] {
    background: var(--iui-color-primary);
    color: var(--iui-color-primary-foreground);
  }
  .dock button:hover { color: var(--iui-color-foreground); }
  .dock button:active { scale: 0.97; }
  .hotel-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--iui-radius-lg);
    min-height: 9.5rem;
    background: linear-gradient(160deg, var(--iui-color-muted), var(--iui-color-surface));
    border: 1px solid var(--iui-color-border);
  }
  .hotel-card .art {
    position: absolute;
    inset: 0;
    opacity: 0.85;
  }
  .hotel-card .meta {
    position: absolute;
    inset: auto 0.6rem 0.6rem 0.6rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--iui-radius-md);
    background: color-mix(in oklab, var(--iui-color-background) 72%, transparent);
    backdrop-filter: blur(8px);
  }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip-row button,
  .stay-pick {
    appearance: none;
    border: 1px solid var(--iui-color-border);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    background: var(--iui-color-muted);
    color: var(--iui-color-foreground);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      border-color var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      background var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing),
      scale var(--iui-motion-state-change-duration) var(--iui-motion-state-change-easing);
  }
  .chip-row button[aria-pressed="true"] {
    border-color: var(--iui-color-primary);
    background: color-mix(in oklab, var(--iui-color-primary) 12%, var(--iui-color-surface));
  }
  .stay-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .stay-pick {
    border-radius: var(--iui-radius-lg);
    padding: 0.9rem 0.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    text-align: center;
  }
  .stay-pick[aria-pressed="true"] {
    border-color: var(--iui-color-primary);
    background: color-mix(in oklab, var(--iui-color-primary) 10%, var(--iui-color-surface));
  }
  .cash-bars { display: grid; gap: 0.55rem; }
  .cash-row { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.55rem; align-items: center; }
  .cash-cells { display: flex; gap: 2px; height: 1.35rem; align-items: end; }
  .cash-cells span {
    flex: 1;
    border-radius: 2px;
    min-height: 4px;
    transition: height var(--iui-motion-layout-duration) var(--iui-motion-layout-easing);
  }
  .cash-cells .inn { background: var(--iui-color-chart-1); }
  .cash-cells .out { background: color-mix(in oklab, var(--iui-color-foreground) 22%, transparent); }
  .dept-bar {
    height: 6px;
    border-radius: 99px;
    background: var(--iui-color-muted);
    overflow: hidden;
  }
  .dept-bar > i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--iui-color-accent);
    transition: width var(--iui-motion-layout-duration) var(--iui-motion-layout-easing);
  }
</style>

<box class="showcase" gap={4}>
  <box show={view == "charts"} class="showcase-panel" gap={3} motion="blur" role="tabpanel" id="showcase-charts" aria-labelledby="showcase-tab-charts">
    <title level={2}>Ad Spend vs Sales</title>
    <grid columns={3} gap={2} stagger>
      <card padding={3} gap={1}>
        <text size="sm" color="muted">Total spend</text>
        <text size="xl" weight="bold" tabular>{"$" + num(totalSpend, 2) + "Mn"}</text>
        <badge color="success" size="sm">+4.8%</badge>
      </card>
      <card padding={3} gap={1}>
        <text size="sm" color="muted">Total sales</text>
        <text size="xl" weight="bold" tabular>{"$" + num(totalSales, 2) + "Mn"}</text>
        <badge color="success" size="sm">+10.7%</badge>
      </card>
      <card padding={3} gap={1}>
        <text size="sm" color="muted">ROI</text>
        <text size="xl" weight="bold" tabular><Number value={roi} format="percent" digits={1} /></text>
        <text size="sm" color="muted">Return on investment</text>
      </card>
    </grid>
    <card padding={4} gap={3}>
      <title level={3}>Spend vs revenue, 2025</title>
      <Chart type="bar" data={spend} x="month" y={["spend", "revenue"]} names={{ spend: "Spend", revenue: "Revenue" }} format="currency" currency="USD" unit="M" height={200} legend aria-label="Monthly spend and revenue in millions of dollars" />
    </card>
    <grid columns={2} gap={3}>
      <card padding={4} gap={3}>
        <title level={3}>Share of global spend</title>
        <Chart type="donut" data={regions} x="region" y="value" format="currency" currency="USD" unit="M" height={160} legend aria-label="Spend by region in millions of dollars" />
      </card>
      <card padding={4} gap={3}>
        <row>
          <title level={3}>Sales and spend over time</title>
          <spacer />
          <badge color="accent" size="sm">3× since 2015</badge>
        </row>
        <Chart type="line" data={years} x="year" y={["sales", "spend"]} names={{ sales: "Sales", spend: "Spend" }} format="currency" currency="USD" unit="M" height={160} legend aria-label="Sales and spend from 2015 to 2025 in millions of dollars" />
      </card>
    </grid>
  </box>

  <box show={view == "cards"} class="showcase-panel" gap={4} motion="rise" role="tabpanel" id="showcase-cards" aria-labelledby="showcase-tab-cards">
    <div class="showcase-split">
      <div class="showcase-copy">
        <title level={2}>Modern hotels in Paris</title>
        <text color="muted">A short list for a long weekend — walkable neighborhoods, quiet rooms, and breakfast worth waking up for.</text>
        <ul>
          <li><text weight="semibold" color="foreground">Hôtel du Marais</text> — courtyard calm near the Seine</li>
          <li><text weight="semibold" color="foreground">Maison Latin</text> — family rooms by the gardens</li>
          <li><text weight="semibold" color="foreground">Opera House Inn</text> — the rooftop pick</li>
        </ul>
      </div>
      <box gap={3}>
        <grid columns={3} gap={2} stagger>
          {#each hotels as hotel (hotel.id)}
            <div class="hotel-card">
              <svg class="art" viewBox="0 0 160 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                {#if hotel.id == "marais"}
                  <rect width="160" height="120" fill="var(--iui-color-chart-1)" opacity="0.35" />
                  <path d="M0 120 L0 78 L28 54 L52 70 L78 42 L110 66 L140 50 L160 62 L160 120 Z" fill="var(--iui-color-chart-1)" opacity="0.55" />
                {:else if hotel.id == "latin"}
                  <rect width="160" height="120" fill="var(--iui-color-chart-3)" opacity="0.35" />
                  <path d="M0 120 L0 78 L28 54 L52 70 L78 42 L110 66 L140 50 L160 62 L160 120 Z" fill="var(--iui-color-chart-3)" opacity="0.55" />
                {:else}
                  <rect width="160" height="120" fill="var(--iui-color-chart-2)" opacity="0.35" />
                  <path d="M0 120 L0 78 L28 54 L52 70 L78 42 L110 66 L140 50 L160 62 L160 120 Z" fill="var(--iui-color-chart-2)" opacity="0.55" />
                {/if}
              </svg>
              <badge color={hotel.color} size="sm" style="position: absolute; top: 0.55rem; left: 0.55rem">{hotel.tag}</badge>
              <div class="meta">
                <text size="sm" weight="semibold">{hotel.name}</text>
                <row gap={2}>
                  <text size="xs" color="muted">★ {hotel.rating}</text>
                  <spacer />
                  <text size="xs" weight="medium">{hotel.price}</text>
                </row>
              </div>
            </div>
          {/each}
        </grid>
        <row gap={2} wrap class="chip-row">
          <badge variant="soft" color="info"><icon name="sun" size="sm" /> Sunny, 24°</badge>
          <badge variant="soft"><icon name="train-front" size="sm" /> 4 min to Métro</badge>
          <badge variant="soft"><icon name="wallet" size="sm" /> EUR · Visa OK</badge>
        </row>
        <card variant="elevated" padding={0} overflow="hidden">
          <row wrap>
            <box flex={1} minWidth={180} minHeight={160} style="position: relative; overflow: hidden">
              <svg viewBox="0 0 280 160" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="display: block; min-height: 160px">
                <defs>
                  <linearGradient id="opera" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="var(--iui-color-chart-2)" stop-opacity="0.55" />
                    <stop offset="100%" stop-color="var(--iui-color-chart-1)" stop-opacity="0.35" />
                  </linearGradient>
                </defs>
                <rect width="280" height="160" fill="url(#opera)" />
                <path d="M0 160 L0 110 L40 88 L72 108 L110 70 L150 98 L190 78 L230 104 L280 86 L280 160 Z" fill="var(--iui-color-chart-2)" opacity="0.45" />
                <rect x="96" y="42" width="88" height="70" rx="6" fill="var(--iui-color-surface)" opacity="0.55" />
                <path d="M96 78 H184 M118 42 V112 M158 42 V112" stroke="var(--iui-color-foreground)" stroke-width="2" opacity="0.35" />
                <circle cx="220" cy="36" r="14" fill="var(--iui-color-chart-3)" opacity="0.7" />
              </svg>
            </box>
            <box padding={4} gap={2} width={260} maxWidth="100%">
              <badge color="warning" size="sm"><icon name="trophy" size="sm" /> Top pick</badge>
              <title level={3}>{picked.name}</title>
              <text size="sm" color="muted">{picked.blurb}</text>
              <row gap={1} wrap>
                <badge size="sm">Piano bar</badge>
                <badge size="sm">Rooftop</badge>
                <badge size="sm">★ {picked.rating}</badge>
              </row>
              <row gap={2}>
                <text weight="semibold">{picked.price}</text>
                <spacer />
                <Button variant="solid" on:click={send("Book " + picked.name)}>Book</Button>
              </row>
            </box>
          </row>
        </card>
      </box>
    </div>
  </box>

  <box show={view == "dashboards"} class="showcase-panel" gap={4} motion="scale" role="tabpanel" id="showcase-dashboards" aria-labelledby="showcase-tab-dashboards">
    <row wrap gap={2}>
      <title level={2}>Q4 budget</title>
      <spacer />
      <badge variant="soft" size="sm"><icon name="refresh-cw" size="sm" /> Just refreshed</badge>
      <Button size="sm">This quarter</Button>
      <Button size="sm" variant="solid">Export</Button>
    </row>
    <grid columns={4} gap={2} stagger>
      <card padding={3} gap={1}>
        <row gap={2}><icon name="trending-up" size="sm" color="accent" /><text size="sm" color="muted">Revenue</text></row>
        <text size="xl" weight="bold" tabular><Number value={1250000} format="currency" digits={0} /></text>
        <badge color="success" size="sm">+8.1%</badge>
      </card>
      <card padding={3} gap={1}>
        <row gap={2}><icon name="wallet" size="sm" color="accent" /><text size="sm" color="muted">Operating spend</text></row>
        <text size="xl" weight="bold" tabular><Number value={815000} format="currency" digits={0} /></text>
        <badge color="success" size="sm">4.0% under</badge>
      </card>
      <card padding={3} gap={1}>
        <row gap={2}><icon name="pie-chart" size="sm" color="accent" /><text size="sm" color="muted">Gross margin</text></row>
        <text size="xl" weight="bold" tabular>62.6%</text>
        <badge color="success" size="sm">+1.2 pt</badge>
      </card>
      <card padding={3} gap={1}>
        <row gap={2}><icon name="timer" size="sm" color="accent" /><text size="sm" color="muted">Runway</text></row>
        <text size="xl" weight="bold" tabular>22 mo</text>
        <badge color="success" size="sm">+2 mo</badge>
      </card>
    </grid>
    <grid columns={3} gap={3}>
      <grid-item span={2}>
        <card padding={4} gap={3}>
          <title level={3}>Cash flow</title>
          <div class="cash-bars">
            {#each cash as row (row.month)}
              <div class="cash-row">
                <text size="sm" color="muted">{row.month}</text>
                <div class="cash-cells" aria-label="{row.month}: cash in {row.inn}, cash out {row.out}">
                  {#each range(0, 12) as i}
                    <span class="inn" style="height: {max(8, row.inn / 12 - i * 2)}px"></span>
                    <span class="out" style="height: {max(6, row.out / 12 - i * 1.5)}px"></span>
                  {/each}
                </div>
              </div>
            {/each}
          </div>
          <row gap={3}>
            <row gap={1}><box width={8} height={8} radius="sm" background="chart-1" /><text size="xs" color="muted">Cash in</text></row>
            <row gap={1}><box width={8} height={8} radius="sm" background="border" /><text size="xs" color="muted">Cash out</text></row>
          </row>
        </card>
      </grid-item>
      <card padding={4} gap={3}>
        <title level={3}>Budget vs actual</title>
        <box gap={3}>
          {#each depts as dept (dept.name)}
            <box gap={1}>
              <row gap={3}>
                <text size="sm" weight="medium" class="nowrap">{dept.name}</text>
                <spacer />
                <text size="sm" tabular color="muted" class="nowrap">{currency(dept.spent * 1000)} / {currency(dept.budget * 1000)}</text>
              </row>
              <div class="dept-bar"><i style="width: {percent(dept.spent / dept.budget)}"></i></div>
            </box>
          {/each}
        </box>
      </card>
    </grid>
    <card padding={4} gap={3}>
      <title level={3}>Recent invoices</title>
      <DataTable data={[
        { vendor: "Vercel", category: "Infra", id: "INV-2041", due: "Nov 12", amount: 4200, status: "paid" },
        { vendor: "Snowflake", category: "Data", id: "INV-2048", due: "Nov 18", amount: 12800, status: "scheduled" },
        { vendor: "Figma", category: "Design", id: "INV-2052", due: "Nov 22", amount: 960, status: "paid" },
        { vendor: "Datadog", category: "Observability", id: "INV-2055", due: "Nov 28", amount: 6100, status: "overdue" }
      ]} rowKey="id" columns={[
        { key: "vendor", label: "Vendor" },
        { key: "category", label: "Category" },
        { key: "id", label: "Invoice" },
        { key: "due", label: "Due" },
        { key: "amount", label: "Amount", format: "currency", align: "right" },
        { key: "status", label: "Status", badge: { paid: "success", scheduled: "info", overdue: "danger" } }
      ]} />
    </card>
  </box>

  <box show={view == "forms"} class="showcase-panel" gap={4} motion="slide-left" role="tabpanel" id="showcase-forms" aria-labelledby="showcase-tab-forms">
    <div class="showcase-split">
      <div class="showcase-copy">
        <title level={2}>Plan a week in Portugal</title>
        <text color="muted">Tell me the cities, the pace and the budget. I'll sketch a day-by-day plan you can edit.</text>
        <list marker="bullet">
          <list-item>Lisbon for food and miradouros</list-item>
          <list-item>Porto for the river and the wine caves</list-item>
        </list>
      </div>
      <card padding={4} gap={4}>
        <box gap={2}>
          <text size="sm" weight="medium">Destinations</text>
          <row gap={2} wrap>
            <badge color="accent"><icon name="map-pin" size="sm" /> Lisbon</badge>
            <badge color="info"><icon name="map-pin" size="sm" /> Porto</badge>
          </row>
        </box>
        <grid columns={2} gap={3}>
          <box gap={1}>
            <text size="sm" weight="medium">Check-in / Check-out</text>
            <row gap={2}>
              <badge variant="soft"><icon name="calendar" size="sm" /> Apr 12</badge>
              <badge variant="soft"><icon name="calendar" size="sm" /> Apr 19</badge>
            </row>
          </box>
          <box gap={1}>
            <text size="sm" weight="medium">Travelers</text>
            <row gap={3}>
              <row gap={2} class="nowrap">
                <text size="sm" color="muted">Adults</text>
                <NumberInput min={1} max={8} bind:value={adults}>
                  <NumberInputGroup>
                    <NumberInputDecrement aria-label="Fewer adults">−</NumberInputDecrement>
                    <NumberInputControl aria-label="Adults" style="width: 2.5rem; text-align: center" />
                    <NumberInputIncrement aria-label="More adults">+</NumberInputIncrement>
                  </NumberInputGroup>
                </NumberInput>
              </row>
              <row gap={2} class="nowrap">
                <text size="sm" color="muted">Children</text>
                <NumberInput min={0} max={6} bind:value={children}>
                  <NumberInputGroup>
                    <NumberInputDecrement aria-label="Fewer children">−</NumberInputDecrement>
                    <NumberInputControl aria-label="Children" style="width: 2.5rem; text-align: center" />
                    <NumberInputIncrement aria-label="More children">+</NumberInputIncrement>
                  </NumberInputGroup>
                </NumberInput>
              </row>
            </row>
          </box>
        </grid>
        <box gap={2}>
          <text size="sm" weight="medium">Interests</text>
          <div class="chip-row">
            {#each interestOptions as opt (opt.id)}
              <button type="button" aria-pressed={interests.includes(opt.id)} on:click={interests = toggle(interests, opt.id)}>
                <icon name={opt.icon} size="sm" /> {opt.label}
              </button>
            {/each}
          </div>
        </box>
        <box gap={2}>
          <text size="sm" weight="medium">Stay</text>
          <div class="stay-grid">
            <button type="button" class="stay-pick" aria-pressed={stay == "boutique"} on:click={stay = "boutique"}>
              <icon name="building-2" size="lg" />
              <text size="sm" weight="medium">Boutique hotel</text>
            </button>
            <button type="button" class="stay-pick" aria-pressed={stay == "apartment"} on:click={stay = "apartment"}>
              <icon name="home" size="lg" />
              <text size="sm" weight="medium">Apartment</text>
            </button>
            <button type="button" class="stay-pick" aria-pressed={stay == "resort"} on:click={stay = "resort"}>
              <icon name="palmtree" size="lg" />
              <text size="sm" weight="medium">Resort</text>
            </button>
          </div>
        </box>
        <box gap={1}>
          <row>
            <text size="sm" weight="medium">Budget</text>
            <spacer />
            <text size="sm" tabular>{currency(500)}–{currency(budget)}</text>
          </row>
          <Slider min={500} max={5000} step={50} bind:value={budget}>
            <SliderControl><SliderTrack><SliderIndicator /><SliderThumb aria-label="Trip budget" /></SliderTrack></SliderControl>
          </Slider>
          <row>
            <text size="xs" color="muted">$500</text>
            <spacer />
            <text size="xs" color="muted">$5,000</text>
          </row>
        </box>
        <row gap={2} wrap>
          <Button variant="solid" on:click={send("Plan my trip", { interests, stay, budget, adults, children })}>Plan my trip</Button>
          <Button on:click={send("Save this trip for later")}>Save for later</Button>
        </row>
      </card>
    </div>
  </box>

  <div class="dock" role="tablist" aria-label="Showcase views">
    <button type="button" role="tab" id="showcase-tab-charts" aria-controls="showcase-charts" aria-selected={view == "charts"} on:click={view = "charts"}>Charts</button>
    <button type="button" role="tab" id="showcase-tab-cards" aria-controls="showcase-cards" aria-selected={view == "cards"} on:click={view = "cards"}>Cards</button>
    <button type="button" role="tab" id="showcase-tab-dashboards" aria-controls="showcase-dashboards" aria-selected={view == "dashboards"} on:click={view = "dashboards"}>Dashboards</button>
    <button type="button" role="tab" id="showcase-tab-forms" aria-controls="showcase-forms" aria-selected={view == "forms"} on:click={view = "forms"}>Forms</button>
  </div>
</box>
